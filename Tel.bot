import os
import sqlite3
import logging
import threading
from datetime import date
from http.server import HTTPServer, BaseHTTPRequestHandler

from groq import Groq
from telegram import Update, LabeledPrice
from telegram.ext import (
    ApplicationBuilder,
    CommandHandler,
    MessageHandler,
    PreCheckoutQueryHandler,
    ContextTypes,
    filters,
)

# =========================================================
# 🌐 DUMMY WEB SERVER FOR RENDER (PORT BINDING)
# =========================================================

class HealthCheckHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Alpha AI Bot is Online & Running!")

    def log_message(self, format, *args):
        # Console logs-la spam varama irukka
        pass

def run_web_server():
    port = int(os.getenv("PORT", "10000"))
    server = HTTPServer(("0.0.0.0", port), HealthCheckHandler)
    server.serve_forever()

# =========================================================
# 🔑 CONFIGURATION
# =========================================================

BOT_TOKEN = os.getenv("BOT_TOKEN")
GROQ_API_KEY = os.getenv("GROQ_API_KEY")
ADMIN_ID = int(os.getenv("ADMIN_ID", "1234567890"))

DAILY_FREE_LIMIT = 5
STARS_PRICE = 50

# =========================================================
# 🤖 GROQ SETTINGS
# =========================================================

MODEL = "llama-3.3-70b-versatile"

SYSTEM_PROMPT = """
You are Alpha AI, a helpful Telegram AI assistant.

Rules:
- Give accurate, fast, and structured answers.
- If the user asks in Tamil, answer in Tamil.
- If the user asks in Tanglish, answer in Tanglish.
- If the user asks in English, answer in English.
- Keep answers clear and informative.
"""

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)
logger = logging.getLogger(__name__)

client = Groq(api_key=GROQ_API_KEY)

# =========================================================
# 🗄️ SQLITE DATABASE
# =========================================================

conn = sqlite3.connect("linkbank.db", check_same_thread=False)
cursor = conn.cursor()

cursor.execute("""
CREATE TABLE IF NOT EXISTS links (
    keyword TEXT PRIMARY KEY,
    link TEXT NOT NULL
)
""")

cursor.execute("""
CREATE TABLE IF NOT EXISTS users (
    user_id INTEGER PRIMARY KEY,
    is_premium INTEGER DEFAULT 0,
    daily_queries INTEGER DEFAULT 0,
    last_query_date TEXT
)
""")
conn.commit()


def register_user(user_id: int):
    cursor.execute(
        """
        INSERT OR IGNORE INTO users (user_id, is_premium, daily_queries, last_query_date)
        VALUES (?, 0, 0, ?)
        """,
        (user_id, str(date.today())),
    )
    conn.commit()


def check_and_update_limit(user_id: int):
    today_str = str(date.today())
    cursor.execute(
        "SELECT is_premium, daily_queries, last_query_date FROM users WHERE user_id = ?",
        (user_id,),
    )
    row = cursor.fetchone()

    if not row:
        register_user(user_id)
        return True, 1, False

    is_premium, daily_queries, last_query_date = row

    if is_premium == 1:
        return True, -1, True

    if last_query_date != today_str:
        cursor.execute(
            "UPDATE users SET daily_queries = 1, last_query_date = ? WHERE user_id = ?",
            (today_str, user_id),
        )
        conn.commit()
        return True, 1, False

    if daily_queries >= DAILY_FREE_LIMIT:
        return False, daily_queries, False

    cursor.execute(
        "UPDATE users SET daily_queries = daily_queries + 1 WHERE user_id = ?",
        (user_id,),
    )
    conn.commit()
    return True, daily_queries + 1, False


# =========================================================
# 🚀 CORE COMMANDS
# =========================================================

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message:
        return

    user = update.effective_user
    register_user(user.id)
    name = user.first_name if user else "Friend"

    welcome_message = f"""
🤖 <b>ALPHA AI + LINK BANK</b>

━━━━━━━━━━━━━━━━━━
👋 Vanakkam {name}!

⚡ Fast AI Responses (Tamil / Tanglish / English)
🎁 Daily Free Limit: <b>{DAILY_FREE_LIMIT} AI questions/day</b>

━━━━━━━━━━━━━━━━━━
🔗 <b>LINK BANK</b>
• Save: <code>/save gemini https://gemini.google.com</code>
• Open: <code>/gemini</code>
• View All: <code>/all</code>
• Delete: <code>/delete gemini</code>

━━━━━━━━━━━━━━━━━━
⭐ <b>PREMIUM UPGRADE</b>
Unlimited AI questions-ku:
👉 Type: <code>/buy</code> (Telegram Stars)

━━━━━━━━━━━━━━━━━━
🧠 <b>ASK AI DIRECTLY</b>
Entha kelviya irundhalum normal-ah type panni anupunga!
"""
    await update.message.reply_text(
        welcome_message, parse_mode="HTML", disable_web_page_preview=True
    )


async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message:
        return

    help_text = """
🆘 <b>ALPHA BOT HELP MENU</b>

━━━━━━━━━━━━━━━━━━
<b>🔗 Link Bank:</b>
• <code>/save &lt;keyword&gt; &lt;url&gt;</code> - Link save panna
• <code>/&lt;keyword&gt;</code> - Saved link edukka (e.g. <code>/gemini</code>)
• <code>/all</code> - Moththa links paarka
• <code>/delete &lt;keyword&gt;</code> - Link delete panna

<b>🧠 Ask AI:</b>
Entha kelvi venaalum direct text-ah anupunga.

<b>⭐ Premium:</b>
• <code>/buy</code> - Unlimited access eduthukka
"""
    await update.message.reply_text(help_text, parse_mode="HTML")


# =========================================================
# 💾 LINK BANK HANDLERS
# =========================================================

async def save_link(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message:
        return

    if len(context.args) < 2:
        await update.message.reply_text(
            "⚠️ <b>Format thappu!</b>\n\nUse: <code>/save keyword URL</code>\nExample:\n<code>/save gemini https://gemini.google.com</code>",
            parse_mode="HTML",
        )
        return

    keyword = context.args[0].lower().lstrip("/")
    link = context.args[1].strip()

    if not (link.startswith("http://") or link.startswith("https://")):
        link = "https://" + link

    cursor.execute(
        "INSERT OR REPLACE INTO links (keyword, link) VALUES (?, ?)", (keyword, link)
    )
    conn.commit()

    await update.message.reply_text(
        f"✅ <b>Link Saved!</b>\nIppo <code>/{keyword}</code> nu type pannale link varum.",
        parse_mode="HTML",
    )


async def list_links(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message:
        return

    cursor.execute("SELECT keyword, link FROM links ORDER BY keyword ASC")
    rows = cursor.fetchall()

    if not rows:
        await update.message.reply_text("📂 Innum entha link-um save pannala.", parse_mode="HTML")
        return

    message = "📚 <b>SAVED LINKS:</b>\n\n"
    for keyword, link in rows:
        message += f"🔗 <code>/{keyword}</code> ➜ {link}\n"

    await update.message.reply_text(message, parse_mode="HTML", disable_web_page_preview=True)


async def delete_link(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message:
        return

    if not context.args:
        await update.message.reply_text("⚠️ Use: <code>/delete keyword</code>", parse_mode="HTML")
        return

    keyword = context.args[0].lower().lstrip("/")
    cursor.execute("DELETE FROM links WHERE keyword = ?", (keyword,))
    conn.commit()

    if cursor.rowcount > 0:
        await update.message.reply_text(f"🗑️ Deleted: <code>/{keyword}</code>", parse_mode="HTML")
    else:
        await update.message.reply_text("❌ Antha keyword kedaikkala.", parse_mode="HTML")


# =========================================================
# ⭐ TELEGRAM STARS PAYMENT
# =========================================================

async def buy_premium(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat_id = update.effective_chat.id
    title = "⭐ Alpha AI Lifetime Premium"
    description = "Unlimited AI questions, priority speed & unlimited storage."
    payload = "alpha_ai_sub"
    currency = "XTR"
    prices = [LabeledPrice("Lifetime Premium", STARS_PRICE)]

    await context.bot.send_invoice(
        chat_id=chat_id,
        title=title,
        description=description,
        payload=payload,
        provider_token="",
        currency=currency,
        prices=prices,
    )


async def precheckout_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.pre_checkout_query
    if query.invoice_payload != "alpha_ai_sub":
        await query.answer(ok=False, error_message="Payment validation error.")
    else:
        await query.answer(ok=True)


async def successful_payment_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    stars_amount = update.message.successful_payment.total_amount

    cursor.execute("UPDATE users SET is_premium = 1 WHERE user_id = ?", (user_id,))
    conn.commit()

    success_text = f"""
🎉 <b>PAYMENT SUCCESSFUL!</b>

━━━━━━━━━━━━━━━━━━
⭐ <b>Stars Paid:</b> {stars_amount} ⭐️
👑 <b>Status:</b> Premium Activated!

Unga account-ku unlimited AI queries unlock aagiduchu! 🚀
━━━━━━━━━━━━━━━━━━
"""
    await update.message.reply_text(success_text, parse_mode="HTML")


# =========================================================
# 📢 ADMIN COMMANDS
# =========================================================

async def broadcast(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        await update.message.reply_text("⛔ Unauthorized.")
        return

    if not context.args:
        await update.message.reply_text("⚠️ Message missing!\nExample: <code>/broadcast Hello all!</code>", parse_mode="HTML")
        return

    broadcast_text = " ".join(context.args)
    cursor.execute("SELECT user_id FROM users")
    all_users = cursor.fetchall()

    delivered, failed = 0, 0
    await update.message.reply_text(f"⏳ Broadcasting to {len(all_users)} users...")

    for (target_id,) in all_users:
        try:
            await context.bot.send_message(chat_id=target_id, text=broadcast_text, parse_mode="HTML")
            delivered += 1
        except Exception:
            failed += 1

    await update.message.reply_text(
        f"✅ <b>Broadcast Completed!</b>\nDelivered: {delivered}\nFailed: {failed}",
        parse_mode="HTML",
    )


async def add_premium(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        await update.message.reply_text("⛔ Unauthorized.")
        return

    if not context.args:
        await update.message.reply_text("⚠️ Use: <code>/addpremium <user_id></code>", parse_mode="HTML")
        return

    target_user_id = int(context.args[0])
    cursor.execute("UPDATE users SET is_premium = 1 WHERE user_id = ?", (target_user_id,))
    conn.commit()

    await update.message.reply_text(f"⭐ User <code>{target_user_id}</code> is now <b>PREMIUM</b>!", parse_mode="HTML")


# =========================================================
# 🔗 DYNAMIC COMMAND HANDLER
# =========================================================

async def handle_saved_link(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message or not update.message.text:
        return

    raw_text = update.message.text.strip()
    if not raw_text.startswith("/") or " " in raw_text:
        return

    keyword = raw_text[1:].lower().strip()
    cursor.execute("SELECT link FROM links WHERE keyword = ?", (keyword,))
    row = cursor.fetchone()

    if row:
        await update.message.reply_text(
            f"🔗 <b>{keyword.upper()}</b>\n\n{row[0]}",
            parse_mode="HTML",
            disable_web_page_preview=True,
        )


# =========================================================
# 🧠 GROQ AI HANDLER
# =========================================================

async def ai_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message or not update.message.text:
        return

    user_message = update.message.text.strip()
    user_id = update.effective_user.id

    if user_message.startswith("/"):
        return

    allowed, used_count, is_prem = check_and_update_limit(user_id)

    if not allowed:
        limit_msg = (
            "⚠️ <b>Daily Free Limit Reached!</b>\n\n"
            f"Innaikana {DAILY_FREE_LIMIT} free AI kelvigal mudinjiduchu.\n"
            "Naalaiku reset aagum, illana <b>/buy</b> click panni Premium eduthukonga! 🚀"
        )
        await update.message.reply_text(limit_msg, parse_mode="HTML")
        return

    try:
        await update.message.chat.send_action("typing")

        response = client.chat.completions.create(
            model=MODEL,
            messages=[
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": user_message},
            ],
            temperature=0.7,
            max_tokens=2048,
        )

        ai_reply = response.choices[0].message.content or "No response from AI."

        if not is_prem:
            remaining = DAILY_FREE_LIMIT - used_count
            footer = f"\n\n<i>[Free Quota: {remaining}/{DAILY_FREE_LIMIT} remaining today]</i>"
            ai_reply += footer

        for i in range(0, len(ai_reply), 4000):
            await update.message.reply_text(ai_reply[i : i + 4000], parse_mode="Markdown")

    except Exception as error:
        logger.error("Groq error: %s", error)
        await update.message.reply_text("❌ Something went wrong with AI. Please try again later.")


# =========================================================
# 🚀 MAIN RUNNER
# =========================================================

def main():
    # 1. Start Web Server in Background Thread for Render Port Check
    print("🌐 Starting background health check server...")
    web_thread = threading.Thread(target=run_web_server, daemon=True)
    web_thread.start()

    # 2. Start Telegram Bot
    print("🤖 Starting Bot polling...")
    app = ApplicationBuilder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(CommandHandler("save", save_link))
    app.add_handler(CommandHandler("all", list_links))
    app.add_handler(CommandHandler("delete", delete_link))

    app.add_handler(CommandHandler("buy", buy_premium))
    app.add_handler(CommandHandler("premium", buy_premium))
    app.add_handler(PreCheckoutQueryHandler(precheckout_callback))
    app.add_handler(MessageHandler(filters.SUCCESSFUL_PAYMENT, successful_payment_callback))

    app.add_handler(CommandHandler("broadcast", broadcast))
    app.add_handler(CommandHandler("addpremium", add_premium))

    app.add_handler(MessageHandler(filters.COMMAND, handle_saved_link))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, ai_message))

    print("✅ Bot is online!")
    app.run_polling(drop_pending_updates=True)


if __name__ == "__main__":
    main()
